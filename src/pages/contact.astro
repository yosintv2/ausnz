---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<BaseLayout title="Contact Us" description="Get in touch with the ANZPostcode team." canonical="https://anzpostcode.com/contact">
  <Header slot="header" />
  <Breadcrumbs items={[{ label: "Contact" }]} />
  <main>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="font-[family-name:var(--font-sora)] text-3xl sm:text-4xl font-bold text-[#0B2545] mb-6">Contact Us</h1>
      <p class="text-[#6B7280] mb-8">Have feedback or found a data issue? We'd love to hear from you.</p>
      <div class="bg-white rounded-2xl border border-[#E2E6ED] p-8">
        <form action="#" method="POST" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-medium text-[#1A1A2E] mb-1">Name</label>
            <input type="text" id="name" name="name" required
              class="w-full px-4 py-2.5 border border-[#E2E6ED] rounded-xl focus:border-[#E8472A] focus:ring-2 focus:ring-[#E8472A]/20 text-sm" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-[#1A1A2E] mb-1">Email</label>
            <input type="email" id="email" name="email" required
              class="w-full px-4 py-2.5 border border-[#E2E6ED] rounded-xl focus:border-[#E8472A] focus:ring-2 focus:ring-[#E8472A]/20 text-sm" />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-[#1A1A2E] mb-1">Message</label>
            <textarea id="message" name="message" rows={5} required
              class="w-full px-4 py-2.5 border border-[#E2E6ED] rounded-xl focus:border-[#E8472A] focus:ring-2 focus:ring-[#E8472A]/20 text-sm resize-none"></textarea>
          </div>
          <button type="submit"
            class="px-6 py-3 bg-[#E8472A] text-white font-semibold rounded-xl hover:bg-[#d43d22] transition-colors text-sm">Send Message</button>
        </form>
        <p class="text-xs text-[#6B7280] mt-4">Note: This is a static site. The form above is for demonstration. Please reach out via our GitHub repository for data corrections.</p>
      </div>
    </div>
  </main>
  <Footer slot="footer" />
</BaseLayout>
