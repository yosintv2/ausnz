---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import FAQAccordion from "../../../components/FAQAccordion";
import DataDisclaimer from "../../../components/DataDisclaimer.astro";
import ShareButtons from "../../../components/ShareButtons";
import MapWrapper from "../../../components/MapWrapper";
import SearchBox from "../../../components/SearchBox";
import CopyButton from "../../../components/CopyButton";
import {
  getAUPostcodeGroups,
  getNearbyAUPostcodes,
  getNearbyAULocalities,
} from "../../../lib/data";
import { stateLabel, titleCase, absoluteUrl, slugify } from "../../../lib/utils";

export async function getStaticPaths() {
  const map = getAUPostcodeGroups();
  return Array.from(map.keys()).map((postcode) => ({
    params: { postcode },
  }));
}

const { postcode } = Astro.params;
const map = getAUPostcodeGroups();
const pg = map.get(postcode!);
if (!pg) return Astro.redirect("/404");

const primary = titleCase(pg.localities[0] ?? "");
const stName = stateLabel(pg.state);
const nearby = getNearbyAUPostcodes(pg.lat, pg.lng, postcode!);
const nearbyLocalities = getNearbyAULocalities(pg.lat, pg.lng, "", 8);
const hasMap = pg.lat !== 0 && pg.lng !== 0;
const pageUrl = absoluteUrl(`/au/postcode/${postcode}`);

const suburbLinks = pg.localities.map((loc) => {
  const sl = slugify(`${loc}-${pg.state}`);
  return `<a href="/au/suburb/${encodeURIComponent(sl)}" class="text-[#E8472A] hover:underline font-medium">${titleCase(loc)}</a>`;
});

const faqs = [
  { question: `What is postcode ${postcode}?`, answer: `Postcode ${postcode} is an Australian postcode covering ${pg.localities.map(titleCase).join(", ")} in ${stName}.` },
  { question: `Which suburbs are in postcode ${postcode}?`, answer: `Postcode ${postcode} includes the following ${pg.localities.length > 1 ? "suburbs" : "suburb"}: ${pg.localities.map(titleCase).join(", ")}.` },
  { question: `What state is postcode ${postcode} in?`, answer: `Postcode ${postcode} is in ${stName} (${pg.state}), Australia.` },
  { question: `Where is postcode ${postcode} located?`, answer: `Postcode ${postcode} is located in ${stName}${hasMap ? ` at approximately ${pg.lat.toFixed(4)}°, ${pg.lng.toFixed(4)}°` : ""}.` },
  { question: `How can I find nearby postcodes?`, answer: `Nearby postcodes include ${nearby.slice(0, 4).map((n) => n.postcode).join(", ")}. You can also use the search box to find other postcodes in ${stName}.` },
  { question: "Is this postcode information official?", answer: "This information is provided for general reference only. For official postal purposes, please check Australia Post." },
];

const faqsForSchema = faqs.map((f) => ({
  "@type": "Question",
  name: f.question,
  acceptedAnswer: { "@type": "Answer", text: f.answer },
}));
---

<BaseLayout
  title={`Postcode ${postcode} – ${primary}, ${pg.state}`}
  description={`Postcode ${postcode} covers ${pg.localities.map(titleCase).join(", ")} in ${stName}, Australia. View map, nearby postcodes, and local suburbs.`}
  canonical={pageUrl}
>
  <Header slot="header" />
  <Breadcrumbs items={[
    { label: "Australia", href: "/au" },
    { label: stName, href: `/au/state/${pg.state.toLowerCase()}` },
    { label: `Postcode ${postcode}` },
  ]} />
  <main>
    <section class="bg-gradient-to-br from-[#0B2545] to-[#112d5e] text-white py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-[#E8472A] text-white text-xs font-semibold px-2.5 py-1 rounded-full">🇦🇺 Australia</span>
              <span class="bg-white/10 text-white/80 text-xs font-medium px-2.5 py-1 rounded-full">{pg.state}</span>
            </div>
            <h1 class="font-[family-name:var(--font-sora)] text-5xl sm:text-7xl font-bold mb-2 tracking-tight">{postcode}</h1>
            <p class="text-white/70 text-xl">{primary} · {stName}</p>
          </div>
          <div class="hidden sm:block">
            <ShareButtons client:load url={pageUrl} title={`Postcode ${postcode} – ${primary}, ${pg.state}`} />
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          <div class="bg-white rounded-2xl border border-[#E2E6ED] p-6">
            <div class="flex items-center justify-between mb-5">
              <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545]">Postcode Details</h2>
              <CopyButton client:load text={`Postcode ${postcode}\n${pg.localities.map(titleCase).join(", ")}\n${stName} (${pg.state}), Australia`} label="Copy address" className="text-[#6B7280] hover:text-[#1A1A2E]" />
            </div>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
              {[
                { label: "Postcode", value: postcode! },
                { label: "Country", value: "Australia 🇦🇺" },
                { label: "State / Territory", value: `${stName} (${pg.state})` },
                ...(hasMap ? [
                  { label: "Latitude", value: pg.lat.toFixed(6) },
                  { label: "Longitude", value: pg.lng.toFixed(6) },
                ] : []),
              ].map((row) => (
                <div class="bg-[#F4F6F9] rounded-xl p-4">
                  <dt class="text-[#6B7280] text-xs uppercase tracking-wider mb-1">{row.label}</dt>
                  <dd class="font-semibold text-[#1A1A2E] text-sm">{row.value}</dd>
                </div>
              ))}
            </dl>
            <div class="mb-5">
              <p class="text-[#6B7280] text-xs uppercase tracking-wider mb-2">Suburbs / Localities</p>
              <div class="flex flex-wrap gap-2">
                {pg.localities.map((loc) => {
                  const sl = slugify(`${loc}-${pg.state}`);
                  return <a key={loc} href={`/au/suburb/${encodeURIComponent(sl)}`}
                    class="px-3 py-1.5 bg-[#F4F6F9] border border-[#E2E6ED] text-[#1A1A2E] text-sm rounded-lg hover:border-[#E8472A] hover:text-[#E8472A] transition-colors">{titleCase(loc)}</a>;
                })}
              </div>
            </div>
            {hasMap && (
              <div class="pt-4 border-t border-[#E2E6ED]">
                <a href={`https://www.openstreetmap.org/?mlat=${pg.lat}&mlon=${pg.lng}&zoom=14&layers=M`} target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#F4F6F9] border border-[#E2E6ED] rounded-xl text-sm font-medium text-[#1A1A2E] hover:border-[#E8472A] hover:text-[#E8472A] transition-colors">
                  📍 Open in OpenStreetMap ↗
                </a>
              </div>
            )}
          </div>

          {pg.localities.length > 1 && (
            <div class="bg-white rounded-2xl border border-[#E2E6ED] p-6">
              <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-5">Suburbs in Postcode {postcode}</h2>
              <div class="flex flex-wrap gap-2">
                {pg.localities.map((loc) => {
                  const sl = slugify(`${loc}-${pg.state}`);
                  return <a key={loc} href={`/au/suburb/${encodeURIComponent(sl)}`}
                    class="px-3 py-1.5 bg-[#F4F6F9] border border-[#E2E6ED] text-[#1A1A2E] text-sm rounded-lg hover:border-[#E8472A] hover:text-[#E8472A] transition-colors">{titleCase(loc)}</a>;
                })}
              </div>
            </div>
          )}

          {hasMap && (
            <div class="bg-white rounded-2xl border border-[#E2E6ED] p-6">
              <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-4">Map of Postcode {postcode}</h2>
              <MapWrapper client:load lat={pg.lat} lng={pg.lng} label={`Postcode ${postcode} – ${primary}`} />
            </div>
          )}

          {nearbyLocalities.length > 0 && (
            <div class="bg-white rounded-2xl border border-[#E2E6ED] p-6">
              <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-4">Nearby Suburbs</h2>
              <div class="flex flex-wrap gap-2">
                {nearbyLocalities.map((l) => (
                  <a key={l.slug} href={`/au/suburb/${l.slug}`}
                    class="px-3 py-1.5 bg-[#F4F6F9] border border-[#E2E6ED] text-[#1A1A2E] text-sm rounded-lg hover:border-[#E8472A] hover:text-[#E8472A] transition-colors">{titleCase(l.locality)}</a>
                ))}
              </div>
            </div>
          )}

          <div>
            <h2 class="font-[family-name:var(--font-sora)] text-xl font-bold text-[#0B2545] mb-5">Frequently Asked Questions</h2>
            <FAQAccordion client:load items={faqs} />
          </div>

          <div class="sm:hidden">
            <ShareButtons client:load url={pageUrl} title={`Postcode ${postcode} – ${primary}, ${pg.state}`} />
          </div>

          <DataDisclaimer />
        </div>

        <div class="space-y-6">
          {nearby.length > 0 && (
            <div class="bg-white rounded-2xl border border-[#E2E6ED] p-5">
              <h3 class="font-[family-name:var(--font-sora)] font-bold text-[#0B2545] mb-4 text-sm">Nearby Postcodes</h3>
              <div class="flex flex-wrap gap-2">
                {nearby.map((n) => (
                  <a key={n.postcode} href={`/au/postcode/${n.postcode}`}
                    class="flex items-center gap-1.5 px-3 py-1.5 bg-[#F4F6F9] border border-[#E2E6ED] rounded-lg hover:border-[#E8472A] hover:text-[#E8472A] transition-colors text-sm">
                    <span class="font-semibold">{n.postcode}</span>
                    <span class="text-[#6B7280] text-xs">{titleCase(n.localities[0] ?? "")}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="bg-[#0B2545] rounded-2xl p-5">
            <h3 class="font-[family-name:var(--font-sora)] font-bold text-white mb-3 text-sm">Search Another Postcode</h3>
            <SearchBox client:load size="sm" placeholder="Search…" />
          </div>

          <div class="bg-white rounded-2xl border border-[#E2E6ED] p-5">
            <h3 class="font-[family-name:var(--font-sora)] font-bold text-[#0B2545] mb-4 text-sm">Related Links</h3>
            <ul class="space-y-2 text-sm">
              <li><a href={`/au/state/${pg.state.toLowerCase()}`} class="text-[#E8472A] hover:underline">All {stName} postcodes</a></li>
              <li><a href="/au/postcodes" class="text-[#E8472A] hover:underline">Browse all AU postcodes</a></li>
              <li><a href="/search" class="text-[#E8472A] hover:underline">Postcode search</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Place",
      name: `Postcode ${postcode} – ${primary}`,
      address: { "@type": "PostalAddress", postalCode: postcode, addressRegion: pg.state, addressCountry: "AU" },
      ...(hasMap ? { geo: { "@type": "GeoCoordinates", latitude: pg.lat, longitude: pg.lng } } : {}),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqsForSchema,
    })} />
  </main>
  <Footer slot="footer" />
</BaseLayout>
