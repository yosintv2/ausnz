---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import FAQAccordion from "../../../components/FAQAccordion";
import DataDisclaimer from "../../../components/DataDisclaimer.astro";
import ShareButtons from "../../../components/ShareButtons";
import MapWrapper from "../../../components/MapWrapper";
import SearchBox from "../../../components/SearchBox";
import {
  getNZLocalityGroups,
  getNearbyNZLocalities,
  getNearbyNZPostcodes,
} from "../../../lib/data";
import { titleCase, absoluteUrl, slugify } from "../../../lib/utils";

export async function getStaticPaths() {
  const map = getNZLocalityGroups();
  return Array.from(map.keys()).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const map = getNZLocalityGroups();
const lg = map.get(slug!);
if (!lg) return Astro.redirect("/404");

const hasMap = lg.lat !== 0 && lg.lng !== 0;
const pageUrl = absoluteUrl(`/nz/locality/${slug}`);
const nearbyLocalities = getNearbyNZLocalities(lg.lat, lg.lng, slug!, 8);
const nearbyPostcodes = getNearbyNZPostcodes(lg.lat, lg.lng, "", 8);

const faqs = [
  { question: `What is the postcode of ${titleCase(lg.locality)}?`, answer: `The postcode for ${titleCase(lg.locality)} is ${lg.postcodes.join(", ")}.` },
  { question: `Which region is ${titleCase(lg.locality)} in?`, answer: `${titleCase(lg.locality)} is located in ${lg.state}, New Zealand.` },
  { question: `What localities are near ${titleCase(lg.locality)}?`, answer: `Nearby localities include ${nearbyLocalities.slice(0, 5).map((l) => titleCase(l.locality)).join(", ")}.` },
  { question: `Where is ${titleCase(lg.locality)} located?`, answer: `${titleCase(lg.locality)} is in ${lg.state}${hasMap ? ` at approximately ${lg.lat.toFixed(4)}°, ${lg.lng.toFixed(4)}°` : ""}.` },
  { question: "Is this postcode information official?", answer: "This information is provided for general reference only. For official postal purposes, please check NZ Post." },
];

const faqsForSchema = faqs.map((f) => ({
  "@type": "Question",
  name: f.question,
  acceptedAnswer: { "@type": "Answer", text: f.answer },
}));
---

<BaseLayout
  title={`${titleCase(lg.locality)} – Postcode ${lg.postcodes.join(", ")}, ${lg.state}`}
  description={`${titleCase(lg.locality)} is a locality in ${lg.state}, New Zealand. Postcode ${lg.postcodes.join(", ")}. View map, nearby localities, and nearby postcodes.`}
  canonical={pageUrl}
>
  <Header slot="header" />
  <Breadcrumbs items={[
    { label: "New Zealand", href: "/nz" },
    { label: lg.state, href: `/nz/region/${slugify(lg.state)}` },
    { label: titleCase(lg.locality) },
  ]} />
  <main>
    <section class="bg-gradient-to-br from-[#1B4332] to-[#2D6A4F] text-white py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-[#2D6A4F] text-white text-xs font-semibold px-2.5 py-1 rounded-full">🇳🇿 New Zealand</span>
              <span class="bg-white/10 text-white/80 text-xs font-medium px-2.5 py-1 rounded-full">{lg.state}</span>
            </div>
            <h1 class="font-[family-name:var(--font-sora)] text-4xl sm:text-5xl font-bold mb-2">{titleCase(lg.locality)}</h1>
            <p class="text-white/70 text-xl">Postcode {lg.postcodes.join(", ")} · {lg.state}</p>
          </div>
          <div class="hidden sm:block">
            <ShareButtons client:load url={pageUrl} title={`${titleCase(lg.locality)} – ${lg.state}`} />
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          <div class="bg-white rounded-2xl border border-[#E2E6ED] p-6">
            <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-5">Locality Details</h2>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
              {[
                { label: "Locality", value: titleCase(lg.locality) },
                { label: "Country", value: "New Zealand 🇳🇿" },
                { label: "Region", value: lg.state },
                { label: "Postcode", value: lg.postcodes.join(", ") },
                ...(hasMap ? [
                  { label: "Latitude", value: lg.lat.toFixed(6) },
                  { label: "Longitude", value: lg.lng.toFixed(6) },
                ] : []),
              ].map((row) => (
                <div class="bg-[#F4F6F9] rounded-xl p-4">
                  <dt class="text-[#6B7280] text-xs uppercase tracking-wider mb-1">{row.label}</dt>
                  <dd class="font-semibold text-[#1A1A2E] text-sm">{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          {hasMap && (
            <div class="bg-white rounded-2xl border border-[#E2E6ED] p-6">
              <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-4">Map of {titleCase(lg.locality)}</h2>
              <MapWrapper client:load lat={lg.lat} lng={lg.lng} label={titleCase(lg.locality)} />
            </div>
          )}

          {nearbyLocalities.length > 0 && (
            <div class="bg-white rounded-2xl border border-[#E2E6ED] p-6">
              <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-4">Nearby Localities</h2>
              <div class="flex flex-wrap gap-2">
                {nearbyLocalities.map((l) => (
                  <a key={l.slug} href={`/nz/locality/${l.slug}`}
                    class="px-3 py-1.5 bg-[#F4F6F9] border border-[#E2E6ED] text-[#1A1A2E] text-sm rounded-lg hover:border-[#2D6A4F] hover:text-[#2D6A4F] transition-colors">{titleCase(l.locality)}</a>
                ))}
              </div>
            </div>
          )}

          <div>
            <h2 class="font-[family-name:var(--font-sora)] text-xl font-bold text-[#0B2545] mb-5">Frequently Asked Questions</h2>
            <FAQAccordion client:load items={faqs} />
          </div>

          <div class="sm:hidden">
            <ShareButtons client:load url={pageUrl} title={`${titleCase(lg.locality)} – ${lg.state}`} />
          </div>

          <DataDisclaimer />
        </div>

        <div class="space-y-6">
          {nearbyPostcodes.length > 0 && (
            <div class="bg-white rounded-2xl border border-[#E2E6ED] p-5">
              <h3 class="font-[family-name:var(--font-sora)] font-bold text-[#0B2545] mb-4 text-sm">Nearby Postcodes</h3>
              <div class="flex flex-wrap gap-2">
                {nearbyPostcodes.slice(0, 6).map((n) => (
                  <a key={n.postcode} href={`/nz/postcode/${n.postcode}`}
                    class="flex items-center gap-1.5 px-3 py-1.5 bg-[#F4F6F9] border border-[#E2E6ED] rounded-lg hover:border-[#2D6A4F] hover:text-[#2D6A4F] transition-colors text-sm">
                    <span class="font-semibold">{n.postcode}</span>
                    <span class="text-[#6B7280] text-xs">{titleCase(n.localities[0] ?? "")}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="bg-[#2D6A4F] rounded-2xl p-5">
            <h3 class="font-[family-name:var(--font-sora)] font-bold text-white mb-3 text-sm">Search Another Locality</h3>
            <SearchBox client:load size="sm" placeholder="Search…" />
          </div>

          <div class="bg-white rounded-2xl border border-[#E2E6ED] p-5">
            <h3 class="font-[family-name:var(--font-sora)] font-bold text-[#0B2545] mb-4 text-sm">Related Links</h3>
            <ul class="space-y-2 text-sm">
              <li><a href={`/nz/region/${slugify(lg.state)}`} class="text-[#2D6A4F] hover:underline">All {lg.state} postcodes</a></li>
              <li><a href="/nz/localities" class="text-[#2D6A4F] hover:underline">All NZ localities</a></li>
              <li><a href="/search" class="text-[#2D6A4F] hover:underline">Search</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Place",
      name: titleCase(lg.locality),
      address: { "@type": "PostalAddress", addressLocality: titleCase(lg.locality), addressRegion: lg.state, postalCode: lg.postcodes[0], addressCountry: "NZ" },
      ...(hasMap ? { geo: { "@type": "GeoCoordinates", latitude: lg.lat, longitude: lg.lng } } : {}),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqsForSchema,
    })} />
  </main>
  <Footer slot="footer" />
</BaseLayout>
