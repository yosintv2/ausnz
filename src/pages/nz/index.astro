---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getNZRegionGroups, getNZPostcodeGroups, getNZLocalityGroups } from "../../lib/data";
import { titleCase } from "../../lib/utils";

const nzRegions = getNZRegionGroups();
const totalPostcodes = getNZPostcodeGroups().size;
const totalLocalities = getNZLocalityGroups().size;
---

<BaseLayout
  title="New Zealand Postcodes"
  description="Browse all New Zealand postcodes, localities, and regions. Search by postcode, locality, or region across New Zealand."
  canonical="https://anzpostcode.com/nz"
>
  <Header slot="header" />
  <Breadcrumbs items={[{ label: "New Zealand" }]} />
  <main>
    <section class="bg-gradient-to-br from-[#1B4332] to-[#2D6A4F] text-white py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="bg-[#2D6A4F] text-white text-xs font-semibold px-3 py-1 rounded-full">🇳🇿 New Zealand</span>
        </div>
        <h1 class="font-[family-name:var(--font-sora)] text-4xl sm:text-5xl font-bold mb-4">New Zealand Postcodes &amp; Localities</h1>
        <p class="text-white/70 text-lg max-w-2xl">Explore postcodes, localities, and regions across {totalPostcodes} postcode areas throughout New Zealand.</p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
        {[
          { label: "Total Postcodes", value: totalPostcodes.toLocaleString() },
          { label: "Total Localities", value: totalLocalities.toLocaleString() },
          { label: "Regions", value: nzRegions.length.toString() },
        ].map((stat) => (
          <div class="bg-white rounded-xl border border-[#E2E6ED] p-5 text-center">
            <div class="font-[family-name:var(--font-sora)] font-bold text-2xl text-[#0B2545]">{stat.value}</div>
            <div class="text-[#6B7280] text-sm mt-1">{stat.label}</div>
          </div>
        ))}
      </div>

      <h2 class="font-[family-name:var(--font-sora)] text-2xl font-bold text-[#0B2545] mb-6">Browse by Region</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
        {nzRegions.map((r) => (
          <a key={r.slug} href={`/nz/region/${r.slug}`}
            class="group bg-white rounded-xl border border-[#E2E6ED] p-6 hover:border-[#2D6A4F] hover:shadow-md transition-all">
            <div class="text-3xl mb-3">🇳🇿</div>
            <h3 class="font-[family-name:var(--font-sora)] font-bold text-lg text-[#0B2545] group-hover:text-[#2D6A4F] transition-colors">{r.state}</h3>
            <div class="flex gap-3 mt-3 text-xs text-[#2D6A4F] font-medium">
              <span>{r.postcodes.length} postcodes</span>
              <span>·</span>
              <span>{r.localityCount} localities</span>
            </div>
          </a>
        ))}
      </div>

      <div class="bg-[#2D6A4F] rounded-2xl p-8 text-white">
        <h2 class="font-[family-name:var(--font-sora)] text-xl font-bold mb-4">Quick Browse</h2>
        <div class="flex flex-wrap gap-3">
          <a href="/nz/postcodes" class="px-4 py-2 bg-white/20 hover:bg-white/30 rounded-lg text-sm font-medium transition-colors">All Postcodes</a>
          <a href="/nz/localities" class="px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-sm font-medium transition-colors">All Localities</a>
          <a href="/nz/a-z" class="px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-sm font-medium transition-colors">A–Z Index</a>
          <a href="/search" class="px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-sm font-medium transition-colors">Search</a>
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" />
</BaseLayout>
