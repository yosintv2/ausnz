---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SearchBox from "../../components/SearchBox";
import { getNZRegionGroups, getNZPostcodeGroups } from "../../lib/data";

const nzRegions = getNZRegionGroups();
const nzMap = getNZPostcodeGroups();
---

<BaseLayout
  title="All New Zealand Postcodes"
  description="Browse all New Zealand postcodes by region. Complete list of postcodes across all NZ regions."
  canonical="https://anzpostcode.com/nz/postcodes"
>
  <Header slot="header" />
  <Breadcrumbs items={[{ label: "New Zealand", href: "/nz" }, { label: "All Postcodes" }]} />
  <main>
    <section class="bg-gradient-to-br from-[#1B4332] to-[#2D6A4F] text-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="font-[family-name:var(--font-sora)] text-4xl sm:text-5xl font-bold mb-3">All New Zealand Postcodes</h1>
        <p class="text-white/70 text-lg">{nzMap.size} postcodes across {nzRegions.length} regions</p>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="sticky top-16 z-40 bg-[#F4F6F9] pb-4 pt-2 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="flex gap-2 overflow-x-auto pb-2">
          {nzRegions.map((r) => (
            <a key={r.slug} href={`#${r.slug}`}
              class="flex-shrink-0 px-4 py-2 bg-white border border-[#E2E6ED] rounded-full text-xs font-medium text-[#0B2545] hover:border-[#2D6A4F] hover:text-[#2D6A4F] transition-colors">{r.state}</a>
          ))}
        </div>
      </div>

      {nzRegions.map((rg) => (
        <section id={rg.slug} class="mb-10">
          <h2 class="font-[family-name:var(--font-sora)] text-xl font-bold text-[#0B2545] mb-1">{rg.state}</h2>
          <p class="text-[#6B7280] text-sm mb-4">{rg.postcodes.length} postcodes</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-2">
            {rg.postcodes.map((p) => (
              <a key={p} href={`/nz/postcode/${p}`}
                class="bg-white border border-[#E2E6ED] rounded-lg px-3 py-2 text-sm hover:border-[#2D6A4F] hover:text-[#2D6A4F] transition-colors">
                <span class="font-semibold">{p}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
  <Footer slot="footer" />
</BaseLayout>
