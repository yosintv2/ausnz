---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getNZLocalityGroups } from "../../lib/data";
import { titleCase } from "../../lib/utils";

const nzMap = getNZLocalityGroups();
const all = Array.from(nzMap.values()).sort((a, b) => a.locality.localeCompare(b.locality));
const alphaMap = new Map<string, typeof all>();
for (const item of all) {
  const first = item.locality.charAt(0).toUpperCase();
  if (!alphaMap.has(first)) alphaMap.set(first, []);
  alphaMap.get(first)!.push(item);
}
const letters = Array.from(alphaMap.keys()).sort();
---

<BaseLayout
  title="All New Zealand Localities"
  description="Browse all New Zealand localities alphabetically. Complete A-Z directory of localities across all regions."
  canonical="https://anzpostcode.com/nz/localities"
>
  <Header slot="header" />
  <Breadcrumbs items={[{ label: "New Zealand", href: "/nz" }, { label: "All Localities" }]} />
  <main>
    <section class="bg-gradient-to-br from-[#1B4332] to-[#2D6A4F] text-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="font-[family-name:var(--font-sora)] text-4xl sm:text-5xl font-bold mb-3">All New Zealand Localities</h1>
        <p class="text-white/70 text-lg">{all.length} localities across New Zealand</p>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="sticky top-16 z-40 bg-[#F4F6F9] pb-4 pt-2 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8">
        <div class="flex gap-1 overflow-x-auto pb-2">
          {letters.map((l) => (
            <a key={l} href={`#letter-${l}`}
              class="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-white border border-[#E2E6ED] rounded text-xs font-bold text-[#0B2545] hover:border-[#2D6A4F] hover:text-[#2D6A4F] transition-colors">{l}</a>
          ))}
        </div>
      </div>

      {letters.map((letter) => {
        const items = alphaMap.get(letter)!;
        return (
          <section id={`letter-${letter}`} class="mb-8">
            <h2 class="font-[family-name:var(--font-sora)] text-xl font-bold text-[#0B2545] mb-4 border-b border-[#E2E6ED] pb-2">{letter}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
              {items.map((item) => (
                <a key={item.slug} href={`/nz/locality/${item.slug}`}
                  class="flex items-center justify-between bg-white border border-[#E2E6ED] rounded-lg px-4 py-2 hover:border-[#2D6A4F] hover:shadow-sm transition-all">
                  <span class="text-sm font-medium text-[#1A1A2E]">{titleCase(item.locality)}</span>
                  <span class="text-xs text-[#6B7280]">{item.state} · {item.postcodes.join(", ")}</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>
  <Footer slot="footer" />
</BaseLayout>
