---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<BaseLayout title="Terms of Use" description="Terms of use for ANZPostcode.com." canonical="https://anzpostcode.com/terms">
  <Header slot="header" />
  <Breadcrumbs items={[{ label: "Terms of Use" }]} />
  <main>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="font-[family-name:var(--font-sora)] text-3xl sm:text-4xl font-bold text-[#0B2545] mb-6">Terms of Use</h1>
      <div class="space-y-6 text-[#6B7280] text-sm">
        <section>
          <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-2">Acceptance of Terms</h2>
          <p>By using ANZPostcode.com, you agree to these terms of use. If you do not agree, please do not use this website.</p>
        </section>
        <section>
          <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-2">Use of Information</h2>
          <p>The postcode and location information provided on this site is for general reference purposes only. While we strive to keep information accurate and up-to-date, we make no representations or warranties of any kind about the completeness, accuracy, or reliability of the data.</p>
        </section>
        <section>
          <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-2">Intellectual Property</h2>
          <p>The content, layout, and design of this website are owned by ANZPostcode.com. You may not reproduce, distribute, or modify the content without prior written consent.</p>
        </section>
        <section>
          <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-2">Limitation of Liability</h2>
          <p>ANZPostcode.com shall not be liable for any damages arising from the use or inability to use this website or the information provided. Users should verify critical information with official postal authorities.</p>
        </section>
        <section>
          <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-2">External Links</h2>
          <p>This website may contain links to external sites. We are not responsible for the content or practices of these third-party websites.</p>
        </section>
        <section>
          <h2 class="font-[family-name:var(--font-sora)] text-lg font-bold text-[#0B2545] mb-2">Changes to Terms</h2>
          <p>We reserve the right to update these terms at any time. Continued use of the site after changes constitutes acceptance of the new terms.</p>
        </section>
      </div>
    </div>
  </main>
  <Footer slot="footer" />
</BaseLayout>
